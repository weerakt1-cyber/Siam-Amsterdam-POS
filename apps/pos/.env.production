# Production feature flags for the Baze POS deployment (public, non-secret).
# Next.js loads this at build time on Vercel.

# BAZE AI Add-On — enabled for this venue. Set to false (or remove) on a
# deployment that hasn't purchased the AI Add-On so it shows the teaser instead.
NEXT_PUBLIC_AI_ADDON=true

# Android APK download shown on /welcome. Served straight from this app's
# public/ folder (public/downloads/baze-pos.apk) — rebuild the APK and replace
# that file to ship a new version. Relative path resolves against the POS origin.
NEXT_PUBLIC_APK_URL=/downloads/baze-pos.apk
